PORT=5001
NODE_ENV=development

# Port 5001, not 5000: macOS Control Center (AirPlay Receiver) occupies 5000.

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/jkfashion?retryWrites=true&w=majority

# The two secrets MUST differ — sharing one means a refresh token is accepted
# as an access token, defeating the short access lifetime entirely.
# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_REFRESH_MAX_AGE_DAYS=30

# Where the panel is served from. CLIENT_ORIGINS is a comma-separated
# allowlist; in development any private-network address is also accepted, so a
# phone on the same Wi-Fi works without a config change.
CLIENT_URL=http://localhost:5173
CLIENT_ORIGINS=http://localhost:5173

# Used once by `npm run seed` to create the first administrator.
# The server refuses to boot in production while the password is the default.
SEED_ADMIN_NAME=JK Fashion Admin
SEED_ADMIN_EMAIL=admin@jkfashion.com
SEED_ADMIN_PASSWORD=change_this_before_deploying

# --- Cloudinary (image uploads for the Look Closer gallery) -----------------
# Optional: the API boots without these, but the gallery upload endpoint will
# return 503 until all three are set. Find them on your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Where uploads are filed inside your Cloudinary media library.
CLOUDINARY_FOLDER=jk-fashion/gallery

# --- SMTP (emails the admin when a website enquiry arrives) -----------------
# Optional: the API boots without these and enquiries are still saved and shown
# in the panel — only the notification email is skipped. The Enquiries tab
# shows a warning while these are unset.
#
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER is the full Gmail
# address, and SMTP_PASSWORD must be a 16-character App Password (Google
# Account → Security → 2-Step Verification → App passwords). A normal account
# password is rejected.
#
# Zoho:      smtp.zoho.in       port 465
# Hostinger: smtp.hostinger.com port 465
# Brevo:     smtp-relay.brevo.com port 587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# SMTP_SECURE is derived from the port (465 = true) unless set explicitly.
# SMTP_SECURE=false

# The From address. Must be one the SMTP account may send as, or the provider
# rejects the message. Defaults to SMTP_USER.
SMTP_FROM=
SMTP_FROM_NAME=JK Fashion Website

# Server-level kill switch. Set to false to stop all notification emails
# without removing the credentials above.
NOTIFY_ENQUIRIES=true
